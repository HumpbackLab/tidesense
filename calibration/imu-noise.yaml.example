# Kalibr input template, NOT measured parameters. Replace every null before use.
# Obtain noise density and bias random walk from stationary IMU data / Allan analysis.
# The driver does not calibrate accelerometer scale/bias or gyro bias.
# The one-command calibrator sets /imu0 automatically. For other bags use their actual topic.
rostopic: /imu0
update_rate: 200.0
accelerometer_noise_density: null   # m/s^2/sqrt(Hz)
accelerometer_random_walk: null     # m/s^3/sqrt(Hz)
gyroscope_noise_density: null       # rad/s/sqrt(Hz)
gyroscope_random_walk: null         # rad/s^2/sqrt(Hz)
