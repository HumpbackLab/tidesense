Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Path
      Name: VIO trajectory
      Enabled: true
      Topic:
        Value: /tidesense/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 70; 230; 110
      Alpha: 1
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.02
      Pose Style: None
    - Class: rviz_default_plugins/Pose
      Name: Current VIO pose
      Enabled: true
      Topic:
        Value: /tidesense/viz_pose
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Shape: Axes
      Axes Length: 0.25
      Axes Radius: 0.01
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: odom
  Enabled: true
Window Geometry:
  Width: 1200
  Height: 800
