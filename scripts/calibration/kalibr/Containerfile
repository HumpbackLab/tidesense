# Kalibr dependencies follow upstream Dockerfile_ros1_20_04.
ARG ROS_IMAGE=public.ecr.aws/docker/library/ros:noetic-ros-base-focal
FROM ${ROS_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
ARG UBUNTU_MIRROR=https://mirrors.ustc.edu.cn/ubuntu
RUN sed -i "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" /etc/apt/sources.list
RUN apt-get -o Acquire::Retries=3 update && apt-get install -y --no-install-recommends \
    ros-noetic-cv-bridge ros-noetic-sensor-msgs git autoconf automake python3-dev python3-pip python3-scipy \
    python3-cairo python3-matplotlib python3-wxgtk4.0 python3-tk python3-igraph python3-pyx \
    python3-catkin-tools python3-osrf-pycommon libeigen3-dev libboost-all-dev \
    libsuitesparse-dev libopencv-dev libpoco-dev libtbb-dev libblas-dev \
    liblapack-dev libv4l-dev doxygen xvfb xauth fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
# Python 3.8-compatible converter; pin numpy below 2 for Kalibr's extensions.
RUN python3 -m pip install --index-url https://pypi.tuna.tsinghua.edu.cn/simple --no-cache-dir 'rosbags==0.9.23' 'numpy==1.24.4'
COPY kalibr-src /catkin_ws/src/kalibr
WORKDIR /catkin_ws
ARG BUILD_JOBS=2
RUN catkin init && catkin config --extend /opt/ros/noetic \
      --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && catkin build -j${BUILD_JOBS} -p1 --no-status
COPY entrypoint.sh /usr/local/bin/tidesense-kalibr
COPY convert.py /usr/local/lib/tidesense-convert.py
ENV MPLBACKEND=Agg OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1
ENTRYPOINT ["/usr/local/bin/tidesense-kalibr"]
