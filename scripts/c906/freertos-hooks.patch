diff --git a/cvitek/task/comm/CMakeLists.txt b/cvitek/task/comm/CMakeLists.txt
--- a/cvitek/task/comm/CMakeLists.txt
+++ b/cvitek/task/comm/CMakeLists.txt
@@ -17,3 +17,80 @@
 add_library(comm STATIC ${_SOURCES})
 install(TARGETS comm DESTINATION lib)
 
+
+# TideSense debug features are explicitly enabled by scripts/c906/build.sh.
+option(TIDESENSE_C906_RELOAD "Enable cooperative C906 firmware RAM reload" OFF)
+option(TIDESENSE_C906_TPU_PROBE "Enable standalone C906 TPU access experiment" OFF)
+option(TIDESENSE_C906_TPU_LK "Enable experimental C906/TPU batched LK" OFF)
+set(TIDESENSE_C906_LK_BATCH "16" CACHE STRING "TPU LK batch size (8, 16, 32)")
+if(TIDESENSE_C906_TPU_LK)
+    if(NOT TIDESENSE_C906_TPU_PROBE)
+        message(FATAL_ERROR "C906 TPU LK requires TIDESENSE_C906_TPU_PROBE")
+    endif()
+    if(NOT TIDESENSE_C906_LK_BATCH MATCHES "^(8|16|32)$")
+        message(FATAL_ERROR "C906 TPU LK batch must be 8, 16 or 32")
+    endif()
+    target_compile_definitions(comm PRIVATE TIDESENSE_C906_TPU_LK
+        LK_TPU_BATCH=${TIDESENSE_C906_LK_BATCH})
+endif()
+if(TIDESENSE_C906_RELOAD)
+    target_compile_definitions(comm PRIVATE TIDESENSE_C906_RELOAD)
+endif()
+if(TIDESENSE_C906_TPU_PROBE)
+    target_compile_definitions(comm PRIVATE TIDESENSE_C906_TPU_PROBE)
+endif()
+
+option(TIDESENSE_C906_LK_DUAL_BATCH "Experimental independent dual LK states with TDMA/TIU overlap" OFF)
+if(TIDESENSE_C906_LK_DUAL_BATCH)
+    target_compile_definitions(comm PRIVATE LK_TPU_DUAL_BATCH=1)
+endif()
+
+option(TIDESENSE_C906_LK_ROI_CACHE "Reuse unchanged current-image LK windows in TPU local memory" OFF)
+if(TIDESENSE_C906_LK_ROI_CACHE)
+    target_compile_definitions(comm PRIVATE LK_TPU_ROI_CACHE=1)
+endif()
+
+if(TIDESENSE_C906_LK_DUAL_BATCH AND (NOT TIDESENSE_C906_LK_ROI_CACHE OR NOT TIDESENSE_C906_LK_BATCH STREQUAL "16"))
+    message(FATAL_ERROR "Dual LK requires ROI cache and 16 lanes")
+endif()
+
+option(TIDESENSE_C906_LK_PROFILE_OCCUPANCY "Profile useful LK lanes and ROI reuse" OFF)
+if(TIDESENSE_C906_LK_PROFILE_OCCUPANCY)
+    target_compile_definitions(comm PRIVATE LK_TPU_PROFILE_OCCUPANCY=1)
+endif()
+
+option(TIDESENSE_C906_LK_FAST_ROI "Avoid libm floor calls in bounded LK patch addressing" OFF)
+if(TIDESENSE_C906_LK_FAST_ROI)
+    target_compile_definitions(comm PRIVATE LK_TPU_FAST_ROI=1)
+endif()
+
+option(TIDESENSE_C906_FRONTEND "Enable experimental pixel-only C906 TPU frontend" OFF)
+option(TIDESENSE_C906_FRONT_FASTMEM "Use aligned scalar stores in frontend fills" OFF)
+option(TIDESENSE_C906_FRONT_PROFILE "Profile pixel frontend sub-stages" OFF)
+option(TIDESENSE_C906_FRONT_ALIGNED_IMAGES "Align frontend gray pixels and pitches for direct IVE input" OFF)
+option(TIDESENSE_C906_FRONT_CPU_TAIL "Allow one idle A53 16-point LK tail batch" OFF)
+option(TIDESENSE_C906_FRONT_SPARSE_NMS "Visit only FAST candidates during NMS" OFF)
+option(TIDESENSE_C906_FRONT_LAZY_MASK "Build top-up masks only when detection is needed" OFF)
+option(TIDESENSE_C906_FRONT_LATEST_INTRINSICS "Read latest coherent camera calibration without waiting for a frame" OFF)
+option(TIDESENSE_C906_FRONT_TPU_BASE_CACHE "Cache fixed TPU bases within one exclusively owned frame" OFF)
+if(TIDESENSE_C906_FRONTEND)
+    if(NOT TIDESENSE_C906_TPU_LK)
+        message(FATAL_ERROR "C906 frontend requires batched TPU LK")
+    endif()
+    enable_language(CXX)
+    set(_front "${TOP_DIR}/../../scripts/vio-compare/probes/c906-frontend/front_kernel.cpp")
+    target_sources(comm PRIVATE "${_front}")
+    target_compile_definitions(comm PRIVATE TIDESENSE_C906_FRONTEND)
+    if(TIDESENSE_C906_FRONT_FASTMEM)
+        target_compile_definitions(comm PRIVATE FRONT_FAST_FILL=1)
+    endif()
+    if(TIDESENSE_C906_FRONT_PROFILE)
+        target_compile_definitions(comm PRIVATE FRONT_PROFILE=1)
+    endif()
+    foreach(_opt SPARSE_NMS LAZY_MASK TPU_BASE_CACHE LATEST_INTRINSICS CPU_TAIL ALIGNED_IMAGES)
+        if(TIDESENSE_C906_FRONT_${_opt})
+            target_compile_definitions(comm PRIVATE FRONT_${_opt}=1)
+        endif()
+    endforeach()
+    set_source_files_properties("${_front}" PROPERTIES COMPILE_FLAGS "-O3 -march=rv64imafdc -mabi=lp64d -mcmodel=medany -ffunction-sections -fdata-sections -fno-exceptions -fno-rtti -fno-threadsafe-statics")
+endif()
diff --git a/cvitek/task/comm/src/riscv64/comm_main.c b/cvitek/task/comm/src/riscv64/comm_main.c
