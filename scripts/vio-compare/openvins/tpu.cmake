option(OPENVINS_C906_TPU_LK "Compile optional TideSense C906/TPU LK and lookahead pipeline" OFF)
option(OPENVINS_EKF_PACKED_F64 "Pack measured covariance columns for the FP64 EKF product" OFF)
option(OPENVINS_BACKEND_DETAIL "Compile opt-in per-update backend diagnostics" OFF)
if(OPENVINS_C906_TPU_LK)
  if(NOT OPENVINS_LK_WINDOW_16X15)
    message(FATAL_ERROR "C906 LK requires OPENVINS_LK_WINDOW_16X15")
  endif()
  set(_support "${OPENVINS_TPU_SDK_ROOT}/scripts/vio-compare/openvins")
  configure_file("${_support}/backend_config.h.in" "${CMAKE_CURRENT_BINARY_DIR}/openvins_backend_config.h" @ONLY)
  target_include_directories(ov_msckf_lib PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  set(OPENVINS_TPU_LK_BATCH "16" CACHE STRING "C906 TPU LK lanes: 8, 16, 32")
  if(NOT OPENVINS_TPU_LK_BATCH MATCHES "^(8|16|32)$")
    message(FATAL_ERROR "Unsupported TPU LK batch")
  endif()
  foreach(_file tpu_lk.cpp front_tpu.cpp)
    set_property(SOURCE "${_support}/${_file}" APPEND PROPERTY COMPILE_DEFINITIONS LK_TPU_BATCH=${OPENVINS_TPU_LK_BATCH})
  endforeach()
  target_sources(ov_msckf_lib PRIVATE "${_support}/tpu_lk.cpp")
  target_include_directories(ov_msckf_lib PUBLIC "${_support}")
  target_compile_definitions(ov_msckf_lib PUBLIC OPENVINS_C906_TPU_LK=1)
  if(CMAKE_CROSSCOMPILING)
    set(_probe "${OPENVINS_TPU_SDK_ROOT}/scripts/vio-compare/probes/c906-tpu")
    target_sources(ov_msckf_lib PRIVATE "${_probe}/lk_jobs.c")
    set_property(SOURCE "${_probe}/lk_jobs.c" APPEND PROPERTY COMPILE_DEFINITIONS
      LK_TPU_BATCH=${OPENVINS_TPU_LK_BATCH})
    target_include_directories(ov_msckf_lib PRIVATE "${_probe}"
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/include" "${OPENVINS_TPU_SDK_ROOT}/cvikernel/include")
    target_link_libraries(ov_msckf_lib
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/lib/libsys.a"
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/lib/libcvikernel-static.a"
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/lib/libcviruntime-static.a" pthread)
  else()
    target_compile_definitions(ov_msckf_lib PRIVATE OPENVINS_TPU_LK_EMULATED_BUILD=1)
  endif()
endif()

option(OPENVINS_C906_FRONTEND "Compile optional complete C906/TPU pixel frontend" OFF)
option(OPENVINS_TPU_LK_DUAL_BATCH "Pair independent 16-lane LK states with TDMA/TIU overlap" OFF)
option(OPENVINS_TPU_LK_ROI_CACHE "Reuse unchanged current-image windows inside TPU LK iterations" OFF)
option(OPENVINS_FRONT_LATEST_INTRINSICS "Publish latest complete intrinsics without frame dependency" OFF)
option(OPENVINS_FRONT_QR7POINT "Use guarded double QR nullspace in fundamental-matrix seven-point hypotheses" OFF)
option(OPENVINS_FRONT_CPU_TAIL "Allow A53 to claim one 16-point tail batch after its backend finishes" OFF)
option(OPENVINS_FRONT_LOCK_EXEC "Allow optional locking of this executable's file mappings" OFF)
option(OPENVINS_FRONT_ALIGNED_IMAGES "Align frontend gray pixels and pitches for direct IVE input" OFF)
option(OPENVINS_FRONT_IVE_HIST "Compile optional C906 IVE histogram callback" OFF)
option(OPENVINS_FRONT_IVE_ST "Compile optional C906 IVE ST candidate response callback" OFF)
if((OPENVINS_FRONT_IVE_HIST OR OPENVINS_FRONT_IVE_ST) AND (NOT OPENVINS_C906_FRONTEND OR NOT OPENVINS_FRONT_ALIGNED_IMAGES))
  message(FATAL_ERROR "IVE callbacks require the aligned C906 frontend")
endif()
option(OPENVINS_C906_FRONTEND_EARLY "Overlap next image preprocessing with current geometry" OFF)
if(OPENVINS_FRONT_QR7POINT AND NOT OPENVINS_C906_FRONTEND)
  message(FATAL_ERROR "QR7 currently requires OPENVINS_C906_FRONTEND")
endif()
if((OPENVINS_FRONT_CPU_TAIL OR OPENVINS_FRONT_LOCK_EXEC OR OPENVINS_FRONT_ALIGNED_IMAGES) AND NOT OPENVINS_C906_FRONTEND)
  message(FATAL_ERROR "CPU tail, executable locking and aligned images require OPENVINS_C906_FRONTEND")
endif()
if(OPENVINS_TPU_LK_DUAL_BATCH AND (NOT OPENVINS_TPU_LK_ROI_CACHE OR NOT OPENVINS_TPU_LK_BATCH STREQUAL "16"))
  message(FATAL_ERROR "Dual LK requires ROI cache and 16 lanes")
endif()
if(OPENVINS_TPU_LK_ROI_CACHE AND NOT OPENVINS_C906_FRONTEND)
  message(FATAL_ERROR "LK ROI cache requires OPENVINS_C906_FRONTEND")
endif()
if(OPENVINS_C906_FRONTEND_EARLY AND NOT OPENVINS_C906_FRONTEND)
  message(FATAL_ERROR "Early frontend requires OPENVINS_C906_FRONTEND")
endif()
if(OPENVINS_C906_FRONTEND)
  if(NOT OPENVINS_C906_TPU_LK)
    message(FATAL_ERROR "C906 frontend requires OPENVINS_C906_TPU_LK")
  endif()
  set(_frontend "${OPENVINS_TPU_SDK_ROOT}/scripts/vio-compare/probes/c906-frontend")
  set(LK_TPU_ROI_CACHE ${OPENVINS_TPU_LK_ROI_CACHE})
  set(LK_TPU_DUAL_BATCH ${OPENVINS_TPU_LK_DUAL_BATCH})
  configure_file("${_support}/frontend_config.h.in" "${CMAKE_CURRENT_BINARY_DIR}/openvins_frontend_config.h" @ONLY)
  target_include_directories(ov_msckf_lib PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
  target_sources(ov_msckf_lib PRIVATE "${_support}/front_tpu.cpp" "${_support}/qr_fundamental.cpp" "${_frontend}/front_kernel.cpp")
  target_compile_definitions(ov_msckf_lib PUBLIC OPENVINS_C906_FRONTEND=1)
  if(OPENVINS_FRONT_ALIGNED_IMAGES)
    target_compile_definitions(ov_msckf_lib PUBLIC FRONT_ALIGNED_IMAGES=1)
  endif()
  foreach(_opt SPARSE_NMS LAZY_MASK IVE_HIST IVE_ST)
    option(OPENVINS_FRONT_${_opt} "Enable frontend kernel ${_opt}" OFF)
    if(OPENVINS_FRONT_${_opt})
      set_property(SOURCE "${_frontend}/front_kernel.cpp" APPEND PROPERTY COMPILE_DEFINITIONS FRONT_${_opt}=1)
    endif()
  endforeach()
  if(OPENVINS_C906_FRONTEND_EARLY)
    target_compile_definitions(ov_msckf_lib PUBLIC OPENVINS_C906_FRONTEND_EARLY=1)
  endif()
  if(CMAKE_CROSSCOMPILING)
    target_sources(ov_msckf_lib PRIVATE "${_frontend}/front_jobs.c")
    if(OPENVINS_FRONT_IVE_HIST OR OPENVINS_FRONT_IVE_ST)
      find_package(Python3 REQUIRED COMPONENTS Interpreter)
      set(_ive "${OPENVINS_TPU_SDK_ROOT}/scripts/vio-compare/probes/c906-ive")
      set(_ivehal "${OPENVINS_TPU_SDK_ROOT}/osdrv/interdrv/ive/hal/cv181x")
      set(_ivegen "${CMAKE_CURRENT_BINARY_DIR}/ive-generated")
      add_custom_command(OUTPUT "${_ivegen}/ive_sdk_generated.inc"
        COMMAND "${Python3_EXECUTABLE}" "${_ive}/generate_sdk.py" "${_ivegen}/ive_sdk_generated.inc"
        DEPENDS "${_ive}/generate_sdk.py" "${_ivehal}/cvi_ive_platform.c" "${_ivehal}/cvi_ive_platform.h" "${_ivehal}/cvi_reg.h")
      target_sources(ov_msckf_lib PRIVATE "${_ive}/ive_jobs.c" "${_ivegen}/ive_sdk_generated.inc")
      set_source_files_properties("${_ive}/ive_jobs.c" PROPERTIES
        OBJECT_DEPENDS "${_ivegen}/ive_sdk_generated.inc" INCLUDE_DIRECTORIES "${_ivegen};${_ivehal}")
    endif()
  endif()
endif()
