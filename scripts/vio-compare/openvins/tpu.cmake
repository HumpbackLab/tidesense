option(OPENVINS_C906_TPU_LK "Compile optional TideSense C906/TPU LK and lookahead pipeline" OFF)
if(OPENVINS_C906_TPU_LK)
  if(NOT OPENVINS_LK_WINDOW_16X15)
    message(FATAL_ERROR "C906 LK requires OPENVINS_LK_WINDOW_16X15")
  endif()
  set(_support "${OPENVINS_TPU_SDK_ROOT}/scripts/vio-compare/openvins")
  target_sources(ov_msckf_lib PRIVATE "${_support}/tpu_lk.cpp")
  target_include_directories(ov_msckf_lib PUBLIC "${_support}")
  target_compile_definitions(ov_msckf_lib PUBLIC OPENVINS_C906_TPU_LK=1)
  if(CMAKE_CROSSCOMPILING)
    set(_probe "${OPENVINS_TPU_SDK_ROOT}/scripts/vio-compare/probes/c906-tpu")
    target_sources(ov_msckf_lib PRIVATE "${_probe}/lk_jobs.c")
    target_include_directories(ov_msckf_lib PRIVATE "${_probe}"
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/include" "${OPENVINS_TPU_SDK_ROOT}/cvikernel/include")
    target_link_libraries(ov_msckf_lib
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/lib/libsys.a"
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/lib/libcvikernel-static.a"
      "${OPENVINS_TPU_SDK_ROOT}/cvi_mpi/lib/libcviruntime-static.a" pthread)
  else()
    target_compile_definitions(ov_msckf_lib PRIVATE OPENVINS_TPU_LK_EMULATED_BUILD=1)
  endif()
endif()

option(OPENVINS_C906_FRONTEND "Compile optional complete C906/TPU pixel frontend" OFF)
option(OPENVINS_C906_FRONTEND_EARLY "Overlap next image preprocessing with current geometry" OFF)
if(OPENVINS_C906_FRONTEND_EARLY AND NOT OPENVINS_C906_FRONTEND)
  message(FATAL_ERROR "Early frontend requires OPENVINS_C906_FRONTEND")
endif()
if(OPENVINS_C906_FRONTEND)
  if(NOT OPENVINS_C906_TPU_LK)
    message(FATAL_ERROR "C906 frontend requires OPENVINS_C906_TPU_LK")
  endif()
  set(_frontend "${OPENVINS_TPU_SDK_ROOT}/scripts/vio-compare/probes/c906-frontend")
  target_sources(ov_msckf_lib PRIVATE "${_support}/front_tpu.cpp" "${_frontend}/front_kernel.cpp")
  target_compile_definitions(ov_msckf_lib PUBLIC OPENVINS_C906_FRONTEND=1)
  if(OPENVINS_C906_FRONTEND_EARLY)
    target_compile_definitions(ov_msckf_lib PUBLIC OPENVINS_C906_FRONTEND_EARLY=1)
  endif()
  if(CMAKE_CROSSCOMPILING)
    target_sources(ov_msckf_lib PRIVATE "${_frontend}/front_jobs.c")
  endif()
endif()
