diff --git a/svo/include/svo/stable_update.h b/svo/include/svo/stable_update.h
new file mode 100644
index 0000000..a223be2
--- /dev/null
+++ b/svo/include/svo/stable_update.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <Eigen/Dense>
+#include <algorithm>
+#include <cmath>
+
+namespace schur_vins {
+// The compressed Schur measurement has H = J^T J, g = J^T r and
+// covariance H. Its gauge nullspace must not be passed to an ordinary
+// innovation solve. Return an equivalent whitened measurement with R = I.
+inline bool whitenSchurMeasurement(const Eigen::MatrixXd& hessian,
+                                   const Eigen::VectorXd& gradient,
+                                   Eigen::MatrixXd& jacobian,
+                                   Eigen::VectorXd& residual) {
+    const int size = hessian.rows();
+    if (!size || hessian.cols() != size || gradient.size() != size ||
+        !hessian.allFinite() || !gradient.allFinite()) return false;
+    const Eigen::MatrixXd symmetric = 0.5 * (hessian + hessian.transpose());
+    Eigen::SelfAdjointEigenSolver<Eigen::MatrixXd> eigen(symmetric);
+    if (eigen.info() != Eigen::Success) return false;
+    const double threshold = std::max(1e-10, eigen.eigenvalues().maxCoeff() * 1e-10);
+    if (eigen.eigenvalues().minCoeff() < -threshold) return false;
+    int rank = 0;
+    for (int i = 0; i < size; ++i)
+        if (eigen.eigenvalues()[i] > threshold) ++rank;
+    if (!rank) return false;
+    jacobian.resize(rank, size);
+    residual.resize(rank);
+    int row = 0;
+    for (int i = 0; i < size; ++i) {
+        const double value = eigen.eigenvalues()[i];
+        if (value <= threshold) continue;
+        const double root = std::sqrt(value);
+        jacobian.row(row) = root * eigen.eigenvectors().col(i).transpose();
+        residual[row] = eigen.eigenvectors().col(i).dot(gradient) / root;
+        ++row;
+    }
+    return jacobian.allFinite() && residual.allFinite();
+}
+}  // namespace schur_vins
diff --git a/svo_common/include/svo/common/pixel_residual.h b/svo_common/include/svo/common/pixel_residual.h
new file mode 100644
index 0000000..0b0bf9c
--- /dev/null
+++ b/svo_common/include/svo/common/pixel_residual.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <vikit/cameras/camera_geometry_base.h>
+#include <cstdlib>
+#include <cstring>
+namespace svo {
+inline bool pixelResidualEnabled() {
+    const char* value = std::getenv("SCHUR_PIXEL_RESIDUAL");
+    return value && std::strcmp(value, "1") == 0;
+}
+inline bool pixelResidual(const vk::cameras::CameraGeometryBase& camera,
+                          const Eigen::Vector3d& bearing,
+                          const Eigen::Vector3d& point,
+                          Eigen::Vector2d& residual,
+                          Eigen::Matrix<double, 2, 3>* jacobian = nullptr) {
+    if (!bearing.allFinite() || !point.allFinite() || point.z() <= 1e-8)
+        return false;
+    Eigen::Vector2d measured, predicted;
+    camera.project3(bearing, &measured);
+    camera.project3(point, &predicted, jacobian);
+    residual = measured - predicted;
+    return residual.allFinite() && (!jacobian || jacobian->allFinite());
+}
+}  // namespace svo
