+namespace {
+int lk_option(const char *name, int fallback, int lower, int upper) {
+  const char *value = std::getenv(name);
+  if (!value) return fallback;
+  char *end = nullptr;
+  long parsed = std::strtol(value, &end, 10);
+  return end != value && *end == '\0' && parsed >= lower && parsed <= upper ? static_cast<int>(parsed) : fallback;
+}
+using LkClock = std::chrono::steady_clock;
+double elapsed_ms(LkClock::time_point a, LkClock::time_point b) {
+  return std::chrono::duration<double, std::milli>(b - a).count();
+}
