+#ifdef OPENVINS_C906_TPU_LK
+void TrackKLT::prefetch_next_camera(const CameraData &message) {
+  if(!TpuLk::pipeline())return;
+#ifdef OPENVINS_C906_FRONTEND
+  if(TpuFront::early() && tpu_next_ && tpu_next_->timestamp==message.timestamp && tpu_next_->ids==message.sensor_ids)return;
+#endif
+  if(tpu_next_)throw std::runtime_error("Unconsumed TPU lookahead frame");
+#ifdef OPENVINS_C906_FRONTEND
+  if(TpuFront::enabled()){tpu_next_=prepare_front_camera(message);return;}
+#endif
+  TpuLk::clear_cache();
+  auto frame=std::make_shared<TpuNextFrame>();
+  frame->timestamp=message.timestamp;frame->ids=message.sensor_ids;
+  // Pixel-only detector owns its IDs and vectors. It never touches the live
+  // feature database or reads calibration while the backend updates it.
+  auto detector=std::make_shared<TrackKLT>(camera_calib,num_features,0,use_stereo,
+      histogram_method,threshold,grid_x,grid_y,min_px_dist);
+  detector->currid=currid.load();
+  for(auto id:message.sensor_ids) {
+    detector->img_pyramid_last[id]=img_pyramid_last.at(id);
+    detector->img_mask_last[id]=img_mask_last.at(id);
+    frame->old_points.push_back(pts_last[id]);frame->old_ids.push_back(ids_last[id]);
+  }
+  auto *raw=frame.get();
+  auto submitted=std::make_shared<std::promise<void>>();
+  auto kickoff=submitted->get_future();
+  frame->worker=std::async(std::launch::async,[raw,detector,message,submitted](){
+    const double worker_begin=TpuLk::now_ms(),worker_cpu=TpuLk::thread_cpu_ms();
+    raw->worker_started.store(true);
+    TpuLk::Deferred defer(raw->requests,submitted.get());
+    for(const auto &input:message.images) {
+      cv::Mat img;
+      if(detector->histogram_method==HistogramMethod::HISTOGRAM)cv::equalizeHist(input,img);
+      else if(detector->histogram_method==HistogramMethod::CLAHE)cv::createCLAHE(10.0,cv::Size(8,8))->apply(input,img);
+      else img=input;
+      std::vector<cv::Mat> pyramid;
+      cv::buildOpticalFlowPyramid(img,pyramid,detector->win_size,detector->pyr_levels,false);
+      raw->images.push_back(img);raw->pyramids.push_back(pyramid);
+    }
+    const double preprocess_end=TpuLk::now_ms(),preprocess_cpu=TpuLk::thread_cpu_ms();
+    raw->events.push_back({"preprocess",worker_begin,preprocess_end,preprocess_cpu-worker_cpu});
+    // Preserve first-frame / all-tracks-lost detection on the new image.
+    if(raw->ids.size()==2 && detector->use_stereo &&
+        (!raw->old_points[0].empty() || !raw->old_points[1].empty())) {
+      auto a=raw->ids[0],b=raw->ids[1];
+      detector->perform_detection_stereo(detector->img_pyramid_last.at(a),detector->img_pyramid_last.at(b),
+          detector->img_mask_last.at(a),detector->img_mask_last.at(b),a,b,
+          raw->old_points[0],raw->old_points[1],raw->old_ids[0],raw->old_ids[1]);
+      raw->detection_ready=true;
+    } else if(raw->ids.size()==1 && !raw->old_points[0].empty()) {
+      auto id=raw->ids[0];
+      detector->perform_detection_monocular(detector->img_pyramid_last.at(id),detector->img_mask_last.at(id),
+          raw->old_points[0],raw->old_ids[0]);
+      raw->detection_ready=true;
+    }
+    raw->events.push_back({"detection",preprocess_end,TpuLk::now_ms(),TpuLk::thread_cpu_ms()-preprocess_cpu});
+    raw->currid_end=detector->currid.load();
+    if(raw->detection_ready)for(size_t i=0;i<raw->ids.size();++i) {
+      std::vector<cv::Point2f> points;
+      for(const auto &p:raw->old_points[i])points.push_back(p.pt);
+      // perform_matching returns without LK below ten points.
+      if(points.size()<10)continue;
+      auto r=TpuLk::prepare(detector->img_pyramid_last.at(raw->ids[i]),raw->pyramids[i],points,points);
+      TpuLk::execute(r);raw->requests.push_back(r);
+    }
+    raw->events.push_back({"worker",worker_begin,TpuLk::now_ms(),TpuLk::thread_cpu_ms()-worker_cpu});
+  });
+  // Blocking kickoff is a comparison mode, disabled by default.
+  const double wait_begin=TpuLk::now_ms(),wait_cpu=TpuLk::thread_cpu_ms();
+  if(TpuLk::kickoff_wait())kickoff.wait();
+  TpuLk::record("kickoff_wait",message.timestamp,wait_begin,TpuLk::now_ms(),TpuLk::thread_cpu_ms()-wait_cpu);
+  tpu_next_=frame;
+}
+#ifdef OPENVINS_C906_FRONTEND
+std::shared_ptr<TpuNextFrame> TrackKLT::prepare_front_camera(const CameraData &message,bool deferred,double previous) {
+  if(message.images.size()!=2 || !use_stereo)throw std::runtime_error("C906 frontend currently supports stereo tracking only");
+  int hist=-1;if(histogram_method==HistogramMethod::NONE)hist=0;else if(histogram_method==HistogramMethod::HISTOGRAM)hist=1;
+  auto frame=std::make_shared<TpuNextFrame>();frame->timestamp=message.timestamp;frame->ids=message.sensor_ids;
+  // A53 only needs image dimensions for geometric filtering. Pixel processing
+  // and padded pyramids stay in the persistent C906-owned workspace.
+  frame->images=message.images;for(const auto &image:message.images)frame->pyramids.push_back({image});
+  std::array<std::vector<cv::KeyPoint>,2> points;
+  std::array<std::vector<size_t>,2> ids;
+  if(!deferred){points={pts_last[message.sensor_ids[0]],pts_last[message.sensor_ids[1]]};
+    ids={ids_last[message.sensor_ids[0]],ids_last[message.sensor_ids[1]]};previous=front_previous_timestamp_;}
+  size_t seed=currid.load();
+  int features=num_features,fast=threshold,gx=grid_x,gy=grid_y,minpx=min_px_dist;
+  auto *raw=frame.get();
+  auto prepared=std::make_shared<std::promise<std::shared_ptr<TpuFrontRequest>>>();
+  frame->prepared_front=prepared->get_future().share();
+  frame->worker=std::async(std::launch::async,[raw,message,points,ids,seed,previous,features,fast,gx,gy,minpx,hist,deferred,prepared](){
+    std::shared_ptr<TpuFrontRequest> r;
+    try {r=TpuFront::prepare(message,previous,points,ids,seed,features,fast,gx,gy,minpx,hist,deferred);}
+    catch(...){prepared->set_exception(std::current_exception());throw;}
+    prepared->set_value(r);
+    TpuFront::execute(r);raw->frontend=r;raw->old_points.resize(2);raw->old_ids.resize(2);
+    for(size_t cam=0;cam<2;++cam)for(unsigned i=0;i<r->result.count[cam];++i){const auto &p=r->result.old[cam][i];
+      raw->old_points[cam].emplace_back(cv::Point2f(p.x,p.y),7,-1,p.response);raw->old_ids[cam].push_back(p.id);}
+    raw->currid_end=r->result.currid;raw->detection_ready=true;
+  });
+  return frame;
+}
+#endif
+#endif
