FROM docker.io/library/node:22-bookworm-slim AS node

FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC \
    LANG=C.UTF-8 \
    BOOST_HEADERS=/opt/boost-1.74/include/boost \
    TIDESENSE_ROS_SETUP=/opt/ros/jazzy/setup.bash

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg && \
    install -d -m 0755 /usr/share/keyrings && \
    curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" \
      > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    autoconf automake bc binutils bison build-essential bzip2 ccache cmake \
    cpio device-tree-compiler dosfstools e2fsprogs file flex gawk gettext \
    git git-lfs libelf-dev libncurses-dev libssl-dev libtool libudev-dev \
    libusb-1.0-0-dev libxml2-dev lz4 mtools ninja-build openssh-client \
    patch pkg-config python3 python3-dev python3-pip python3-setuptools \
    python3-venv python3-yaml rsync sshpass swig tar texinfo unzip wget \
    xxd xz-utils zip zlib1g-dev \
    ros-jazzy-ros-base ros-jazzy-rmw-cyclonedds-cpp \
    ros-jazzy-rclpy ros-jazzy-geometry-msgs ros-jazzy-std-msgs \
    ros-dev-tools && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL --retry 5 --retry-all-errors \
      https://archive.ubuntu.com/ubuntu/pool/main/b/boost1.74/libboost1.74-dev_1.74.0-14ubuntu3_amd64.deb \
      -o /tmp/libboost1.74-dev.deb && \
    mkdir -p /opt/boost-1.74 && \
    dpkg-deb --fsys-tarfile /tmp/libboost1.74-dev.deb | \
      tar --no-same-owner --no-same-permissions --no-overwrite-dir \
        -xf - -C /opt/boost-1.74 && \
    mv /opt/boost-1.74/usr/include /opt/boost-1.74/include && \
    rm -rf /opt/boost-1.74/usr /tmp/libboost1.74-dev.deb

# TideConfigurator uses Podman for the optional calibration environment.
RUN apt-get update && apt-get install -y --no-install-recommends podman catatonit && \
    rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/ /usr/local/

# Install dependencies into the image's default Python; application source and
# frontend output are always taken from the user's checkout at runtime.
COPY requirements.txt /tmp/tidesense-requirements/requirements.txt
COPY calibration/requirements.txt /tmp/tidesense-requirements/calibration/requirements.txt
RUN /usr/bin/python3 -m pip install --break-system-packages --no-cache-dir \
      pycryptodome -r /tmp/tidesense-requirements/requirements.txt && \
    rm -rf /tmp/tidesense-requirements

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-ec", "source \"${TIDESENSE_ROS_SETUP}\"; exec \"$@\"", "tidesense-dev"]
CMD ["bash"]

# Rootless Podman-in-Podman needs VFS storage and no nested cgroup management.
RUN printf '[storage]\ndriver="vfs"\nrunroot="/run/containers/storage"\ngraphroot="/var/lib/containers/storage"\n' > /etc/containers/storage.conf && \
    printf '[containers]\ncgroups="disabled"\ninit_path="/usr/bin/catatonit"\n' > /etc/containers/containers.conf && \
    ln -s /usr/bin/python3 /usr/local/bin/python

RUN apt-get update && apt-get install -y --no-install-recommends \
    kmod libpcre3 python3-jinja2 python3-colorama \
    squashfs-tools && \
    rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.source="https://github.com/HumpbackLab/tidesense" \
      org.opencontainers.image.title="TideSense SDK development environment" \
      org.opencontainers.image.description="Ubuntu 24.04 SDK, ROS 2, and TideConfigurator development tools"
